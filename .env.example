# Reference copy of every variable. The owner uses .env.tpl with 1Password instead
# (op inject -i .env.tpl -o .env). .env is gitignored.

# LLM providers
ANTHROPIC_API_KEY=            # required for review and judge passes
OPENAI_API_KEY=               # optional, phase 4 leaderboard
OLLAMA_HOST=http://localhost:11434   # optional, phase 4 local model

# Pinned model snapshots (change only via a DECISIONS.md line)
ELUSION_OPENAI_MODEL=gpt-6-luna   # pinned OpenAI review model (phase 4); needs OPENAI_API_KEY
ELUSION_REVIEW_MODEL=claude-haiku-5-5   # bulk pass; the API echoes the exact model in every response
ELUSION_JUDGE_MODEL=claude-opus-5-5     # phase 3 judge (labels the gold set); phase 4 reuses it

# Spend guard: review refuses runs projected above this
ELUSION_MAX_RUN_USD=10

# Collection
ELUSION_DATA_DIR=data         # Parquet corpus and caches; gitignored
ELUSION_SEC_USER_AGENT=       # optional, "Your Name you@example.com"; enables CIK -> company name
                              # lookup from sec.gov, which rejects requests without a contact

# Local services (match compose.yaml)
DATABASE_URL=postgresql://elusion:elusion@localhost:5433/elusion
KAFKA_BOOTSTRAP=localhost:9092
MLFLOW_TRACKING_URI=http://localhost:5001
PREFECT_API_URL=http://localhost:4200/api
