# Copy to .env and fill in. .env is gitignored.

# LLM providers
ANTHROPIC_API_KEY=            # required for review and judge passes
OPENAI_API_KEY=               # optional, phase 4 leaderboard
OLLAMA_HOST=http://localhost:11434   # optional, phase 4 local model

# Pinned model snapshots (change only via a DECISIONS.md line)
ELUSION_REVIEW_MODEL=         # e.g. a dated Haiku-class snapshot id
ELUSION_JUDGE_MODEL=          # e.g. a dated Sonnet/Opus-class snapshot id

# Spend guard: review refuses runs projected above this
ELUSION_MAX_RUN_USD=10

# Local services (match compose.yaml)
DATABASE_URL=postgresql://elusion:elusion@localhost:5432/elusion
KAFKA_BOOTSTRAP=localhost:9092
MLFLOW_TRACKING_URI=http://localhost:5000
PREFECT_API_URL=http://localhost:4200/api
